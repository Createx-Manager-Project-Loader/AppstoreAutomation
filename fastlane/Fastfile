default_platform(:ios)

def repo_root
  File.expand_path("../..", __dir__)
end

def prepared_dir
  ENV.fetch("AUTOMATION_PREPARED_DIR") { File.join(repo_root, "automation-prepared") }
end

platform :ios do
  def app_store_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Update What's New text in App Store Connect"
  lane :update_whats_new do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: File.join(repo_root, "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      individual_metadata_items: ["release_notes", "support_url", "marketing_url"],
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "First release: full metadata for an app that is not in the store yet"
  lane :first_release do
    # Отличие от upload_metadata: individual_metadata_items НЕ задаётся —
    # заливается всё, что разложено на диске, а не выбранный набор полей.
    # Первая заливка заполняет карточку целиком, выбирать тут нечего.
    options = {
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("FIRST_RELEASE_METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: ENV["FIRST_RELEASE_SCREENSHOTS_PATH"].nil?,
      skip_app_version_update: false,
      submit_for_review: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    }

    screenshots = ENV["FIRST_RELEASE_SCREENSHOTS_PATH"]
    options[:screenshots_path] = screenshots if screenshots

    # Возрастной рейтинг здесь не передаётся: его пишет setup_app.py прямым
    # вызовом ageRatingDeclaration, чтобы у анкеты был один владелец.

    # Способ релиза словами листинга (§6 канона): manual | automatic | phased.
    # manual передаётся ЯВНО как automatic_release: false. Не передать ничего —
    # не то же самое: deliver тогда пишет «Release type will not be set» и
    # оставляет то, что стояло в карточке раньше. Проверено на живом
    # приложении: с пустым значением releaseType остался AFTER_APPROVAL.
    case ENV["FIRST_RELEASE_RELEASE_TYPE"].to_s.downcase
    when "manual" then options[:automatic_release] = false
    when "automatic" then options[:automatic_release] = true
    when "phased"
      options[:automatic_release] = true
      options[:phased_release] = true
    when "scheduled" then options[:auto_release_date] = ENV.fetch("FIRST_RELEASE_RELEASE_DATE")
    end

    deliver(options)
  end

  desc "Upload App Store Connect metadata and screenshots"
  lane :upload_metadata do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH") { File.join(prepared_dir, "metadata") },
      screenshots_path: File.join(prepared_dir, "screenshots"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      individual_metadata_items: ENV.fetch("ASC_METADATA_ITEMS", "name,subtitle,keywords,description,release_notes").split(","),
      force: true
    )
  end

  desc "Upload App Store Connect metadata for one locale"
  lane :upload_metadata_for_locale do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      individual_metadata_items: ENV.fetch("ASC_METADATA_ITEMS", "subtitle,keywords,description,release_notes").split(","),
      force: true
    )
  end

  desc "Upload app name and subtitle for one locale"
  lane :upload_app_info_for_locale do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      individual_metadata_items: ["name", "subtitle"],
      force: true
    )
  end

  desc "Upload app subtitle for one locale"
  lane :upload_app_subtitle_for_locale do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      individual_metadata_items: ["subtitle"],
      force: true
    )
  end

  desc "Update What's New text in App Store Connect for one locale"
  lane :update_whats_new_for_locale do
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      individual_metadata_items: ["release_notes", "support_url", "marketing_url"],
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
